// Panel rezerwacji Bryziówka — schemat bazy
// SQLite na start; zmiana na Postgres = podmiana provider + DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // połączenie pooled (Neon, pgBouncer) — runtime
  directUrl = env("DIRECT_URL") // połączenie bezpośrednie — migracje
}

/// Domek (Bryziówka 1, Bryziówka 2)
model Cottage {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  capacity       Int           @default(6)
  // Link iCal eksportu z Booking.com — zajętość zaciągamy do siebie
  bookingIcalUrl String?

  // Dane prezentacyjne (oferta). Część zweryfikowana z publicznych źródeł,
  // ceny/zdjęcia/opis własny do uzupełnienia przez właściciela (z FB).
  description String? // opis marketingowy
  areaM2      Int? // metraż
  bedrooms    Int? // liczba sypialni
  beds        String? // np. "1 podwójne, 2 pojedyncze + sofa"
  amenities   String? // JSON: lista udogodnień
  pricePerNight Int? // PLN za dobę; null = „cena na zapytanie"
  petsAllowed Boolean @default(false)
  address     String?
  photos      String? // JSON: lista URLi zdjęć

  reservations   Reservation[]
  createdAt      DateTime      @default(now())
}

/// Rezerwacja (własna lub zaimportowana z Booking)
model Reservation {
  id         String   @id @default(cuid())
  cottage    Cottage  @relation(fields: [cottageId], references: [id], onDelete: Cascade)
  cottageId  String
  guestName  String?
  phone      String?
  guests     Int      @default(2)
  checkIn    DateTime // dzień zameldowania (data, godzina 14:00 umowna)
  checkOut   DateTime // dzień wymeldowania (data, godzina 11:00 umowna)
  source     String   @default("direct") // direct | booking
  externalId String? // UID z iCal Booking — do deduplikacji przy synchronizacji
  status     String   @default("confirmed") // confirmed | cancelled
  notes      String?
  // Grafik sprzątania: oznaczane przez panią sprzątającą po wymeldowaniu
  cleanedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cottageId, source, externalId])
  @@index([cottageId, checkIn])
}
