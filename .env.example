# Baza danych (SQLite na start; w produkcji np. Postgres)
DATABASE_URL="file:./dev.db"

# Hasło właściciela do logowania w panelu
OWNER_PASSWORD="zmien-mnie"

# Sekret do podpisywania ciasteczka sesji (długi losowy ciąg)
SESSION_SECRET="wygeneruj-dlugi-losowy-sekret"

# Token w linku do grafiku sprzątania: /sprzatanie/<TOKEN>
CLEANING_TOKEN="wygeneruj-token"

# Publiczny URL aplikacji (do linków iCal eksportowanych do Booking)
APP_URL="https://twoja-domena.pl"
